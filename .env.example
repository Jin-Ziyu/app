# Public values (safe in the browser; protected by RLS). Used by `npm run build`
# to generate config.js, e.g. in Netlify > Site settings > Environment variables.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# ---- Local scripts only. NEVER expose these to the browser or commit real values. ----
# Needed only for `npm run create-demo-user` (creates the demo account server-side).
SUPABASE_SERVICE_ROLE_KEY=
DEMO_USERNAME=jujiang
DEMO_PASSWORD=

# Local dev server (`npm run dev`): creates/updates the demo user in the local DB.
# DEMO_PASSWORD above is reused. PORT defaults to 8787.
PORT=8787
